{
 "note": "E1: SYCL on the CPU with the generic SYCL BLAS backend (fnn-sycl-generic image)",
 "defaults": {
  "backend": "syclnn",
  "device": "cpu",
  "epochs": 5,
  "repeat": 5
 },
 "runs": [
  {
   "workload": "monk",
   "dtype": "float",
   "options": {
    "blas": "generic"
   }
  },
  {
   "workload": "monk",
   "dtype": "double",
   "options": {
    "blas": "generic"
   }
  },
  {
   "workload": "cup",
   "dtype": "float",
   "options": {
    "blas": "generic"
   }
  },
  {
   "workload": "cup",
   "dtype": "double",
   "options": {
    "blas": "generic"
   }
  },
  {
   "workload": "mnist-512-256",
   "dtype": "float",
   "batch": 64,
   "epochs": 3,
   "repeat": 3,
   "options": {
    "blas": "generic"
   }
  },
  {
   "workload": "mnist-512-256",
   "dtype": "float",
   "batch": 256,
